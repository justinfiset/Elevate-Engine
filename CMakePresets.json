{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "displayName": "Windows / MSVC / Ninja Multi-Config"
    },
    {
      "name": "visual-studio-2022",
      "inherits": "base",
      "displayName": "Windows / Visual Studio 2022 Solution",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "visual-studio-2026",
      "inherits": "base",
      "displayName": "Windows / Visual Studio 2026 Solution",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "linux-clang",
      "inherits": "base",
      "displayName": "Linux / Clang / Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "base",
      "displayName": "Linux / GCC / Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "web",
      "inherits": "base",
      "displayName": "Emscripten / Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "visual-studio-2022",
      "configurePreset": "visual-studio-2022"
    },
    {
      "name": "visual-studio-2026",
      "configurePreset": "visual-studio-2026"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
