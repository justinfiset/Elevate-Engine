function(ee_pascal_case input output)
  string(REGEX REPLACE "[^A-Za-z0-9]+" ";" parts "${input}")
  set(result "")
  foreach(part IN LISTS parts)
    if(part STREQUAL "")
      continue()
    endif()
    string(SUBSTRING "${part}" 0 1 first)
    string(SUBSTRING "${part}" 1 -1 rest)
    string(TOUPPER "${first}" first)
    string(APPEND result "${first}${rest}")
  endforeach()
  if(result STREQUAL "")
    message(FATAL_ERROR "Cannot generate a C++ identifier from '${input}'")
  endif()
  if(result MATCHES "^[0-9]")
    set(result "_${result}")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ee_normalize_uri_prefix input output)
  if(input MATCHES "^([A-Za-z0-9.+-]+://)(.*)$")
    set(scheme "${CMAKE_MATCH_1}")
    set(path "${CMAKE_MATCH_2}")
    string(REGEX REPLACE "^/+" "" path "${path}")
    string(REGEX REPLACE "/+$" "" path "${path}")
    set(result "${scheme}${path}")
  else()
    string(REGEX REPLACE "/+$" "" result "${input}")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ee_escape_cpp_string input output)
  set(result "${input}")
  string(REPLACE "\\" "\\\\" result "${result}")
  string(REPLACE "\"" "\\\"" result "${result}")
  string(REPLACE "\n" "\\n" result "${result}")
  string(REPLACE "\r" "\\r" result "${result}")
  string(REPLACE "\t" "\\t" result "${result}")
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ee_generate_resources rootDir uriPrefix outFile namespace moduleName)
  file(GLOB_RECURSE resourceFiles CONFIGURE_DEPENDS LIST_DIRECTORIES false "${rootDir}/*.png")
  list(SORT resourceFiles)

  ee_normalize_uri_prefix("${uriPrefix}" prefix)

  set(baseNames "")
  string(REGEX REPLACE "[.:]+" ";" namespaceParts "${namespace}")
  foreach(part IN LISTS namespaceParts)
    ee_pascal_case("${part}" pascal)
    list(APPEND baseNames "${pascal}")
  endforeach()
  string(JOIN "::" baseNamespace ${baseNames})

  set(content "")
  string(APPEND content "// Auto-generated C++ module: ${moduleName}\n")
  string(APPEND content "// Do not edit this file manually.\n")
  string(APPEND content "\n")
  string(APPEND content "export module ${moduleName};\n")
  string(APPEND content "\n")

  set(seenNames "")
  foreach(resourceFile IN LISTS resourceFiles)
    file(RELATIVE_PATH relative "${rootDir}" "${resourceFile}")
    string(REPLACE "\\" "/" relative "${relative}")

    get_filename_component(directory "${relative}" DIRECTORY)
    get_filename_component(fileName "${relative}" NAME)
    string(REGEX REPLACE "\\.[^.]*$" "" fileName "${fileName}")
    ee_pascal_case("${fileName}" constantName)

    set(resourceNamespace "${baseNamespace}")
    if(NOT directory STREQUAL "" AND NOT directory STREQUAL ".")
      string(REPLACE "/" ";" directoryParts "${directory}")
      set(extraNames "")
      foreach(part IN LISTS directoryParts)
        ee_pascal_case("${part}" pascal)
        list(APPEND extraNames "${pascal}")
      endforeach()
      string(JOIN "::" extraNamespace ${extraNames})
      set(resourceNamespace "${baseNamespace}::${extraNamespace}")
    endif()

    set(qualified "${resourceNamespace}::${constantName}")
    if(qualified IN_LIST seenNames)
      message(FATAL_ERROR "Duplicate generated resource identifier '${qualified}' (from '${relative}')")
    endif()
    list(APPEND seenNames "${qualified}")

    if(prefix STREQUAL "")
      set(virtualPath "${relative}")
    elseif(prefix MATCHES "://$")
      set(virtualPath "${prefix}${relative}")
    else()
      set(virtualPath "${prefix}/${relative}")
    endif()
    ee_escape_cpp_string("${virtualPath}" escapedPath)

    string(APPEND content "export namespace ${resourceNamespace}\n")
    string(APPEND content "{\n")
    string(APPEND content "    inline constexpr const char* ${constantName} = \"${escapedPath}\";\n")
    string(APPEND content "}\n")
    string(APPEND content "\n")
  endforeach()

  if(EXISTS "${outFile}")
    file(READ "${outFile}" existing)
    string(REPLACE "\r\n" "\n" existing "${existing}")
    if(existing STREQUAL content)
      return()
    endif()
  endif()
  get_filename_component(outDir "${outFile}" DIRECTORY)
  file(MAKE_DIRECTORY "${outDir}")
  file(WRITE "${outFile}" "${content}")
  message(STATUS "Generated resources: ${moduleName}")
endfunction()
